rules_version = '2';

// Rules for the Invaders leaderboard. Paste these into the Firebase console
// under Firestore Database > Rules, then Publish.
//
// Each board lives at boards/{code}/scores, where the code is the private
// ?board= part of a family's link. There are no rules for listing boards, so
// a board can only be read by someone who knows its code.
service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{board}/scores/{scoreId} {
      allow read: if true;

      // Only the game (signed in anonymously) can add a score, and only a
      // well-formed one: three capital letters, a sensible whole-number
      // score, and when it was played, which can't be in the future.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['initials', 'score', 'playedAt'])
        && request.resource.data.initials is string
        && request.resource.data.initials.matches('^[A-Z]{3}$')
        && request.resource.data.score is int
        && request.resource.data.score > 0
        && request.resource.data.score <= 10000000
        && request.resource.data.playedAt is timestamp
        && request.resource.data.playedAt <= request.time;

      // Scores can't be changed or removed from the game.
      allow update, delete: if false;
    }
  }
}
